# OpenAI-compatible server (LM Studio, llama.cpp, Ollama proxy, vLLM, etc.)
OPENAI_BASE_URL=http://YOUR-LLM-LAPTOP-IP:8000/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=mistralai/ministral-3-3b

# Optional Supabase persistence. Leave blank to use backend memory storage.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173
